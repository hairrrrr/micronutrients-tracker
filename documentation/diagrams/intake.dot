// intake.dot - generated by documentation/diagrams/build.mjs.
// Edit the script, then run: npm run docs:diagrams
digraph intake {
  graph [rankdir=TB, compound=true, fontname="Noto Sans CJK SC", fontsize=12,
         bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.55"];
  node [fontname="Noto Sans CJK SC", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.7];

  pick [label="点开食物，选计量或输入克数\ndocs/js/ui/foods.js", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  grams [label="换算成克\ncore/measures.js gramsForSelection", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  edible [label="带骨食物换成可食部克数\ncalc.edibleGramsOf（如排骨 30% 是骨）", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  per100 [label="按每 100 g 折算\ncalc.intakeTotals", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  totals [label="每种营养素的合计\n所有已选食物相加", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  compare [label="逐个营养素比较\ncalc.status", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  dri [label="当天目标与上限\ndocs/data/dri.json", fillcolor="#F1ECF8", color="#7D5BA6", fontcolor="#1B1B1B", shape=cylinder, style="filled"];
  dri_js [label="core/dri.js targetsFor\n按标准、性别、年龄组取目标", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  remain [label="还差 …（目标还没到）", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  met [label="已达标", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  surplus [label="+ …（超过目标的部分）", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  ul [label="超过上限 UL\n红色边框提醒", fillcolor="#FCE8E6", color="#C0392B", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
    { rank=same; edible; dri; }
    { rank=same; per100; dri_js; }
    { rank=same; remain; met; surplus; ul; }

  pick -> grams [color="#666666"];
  grams -> edible [color="#666666"];
  edible -> per100 [color="#666666"];
  per100 -> totals [color="#666666"];
  totals -> compare [color="#666666"];
  dri -> dri_js [color="#666666"];
  dri_js -> compare [color="#666666", label="标准、性别、年龄"];
  compare -> remain [color="#666666"];
  compare -> met [color="#666666"];
  compare -> surplus [color="#666666"];
  compare -> ul [color="#666666"];
  subgraph cluster_legend {
    label="图例";
    fontsize=11;
    style="rounded,dashed";
    color="#999999";
    node [fontname="Noto Sans CJK SC", margin="0.10,0.05"];
    legend_input [label="输入 / 输出：用户、浏览器、文件", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled", fontsize=9];
    legend_code [label="本项目代码", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled", fontsize=9];
    legend_stored [label="存储的数据：CSV、JSON、localStorage", fillcolor="#F1ECF8", color="#7D5BA6", fontcolor="#1B1B1B", shape=cylinder, style="filled", fontsize=9];
    legend_error [label="被拒绝 / 出错的分支", fillcolor="#FCE8E6", color="#C0392B", fontcolor="#1B1B1B", shape=box, style="rounded,filled", fontsize=9];
    { rank=same; legend_input; legend_code; legend_stored; legend_error; }
  }
}

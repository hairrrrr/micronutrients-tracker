// ordering.dot - generated by documentation/diagrams/build.mjs.
// Edit the script, then run: npm run docs:diagrams
digraph ordering {
  graph [rankdir=TB, compound=true, fontname="Noto Sans CJK SC", fontsize=12,
         bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.55"];
  node [fontname="Noto Sans CJK SC", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Noto Sans CJK SC", fontsize=10, arrowsize=0.7];

  confirmed [label="用户确认的食物\nstate.order 里记着确认顺序", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  rest [label="其余食物\nper100g > 0 才进列表", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  pinned [label="第 1 组：已选中的食物\n只收 per100g > 0 的，按确认顺序", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  leading [label="第 2 组：pinTop 食物\n未选中的包装标签牛奶，按 foods.json 顺序", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  tier [label="第 3 组：其余食物\n先按常见度分层，层级高的在前", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  rich [label="同一层里按含量排序\nper100g × amountBasisG / 100", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  basis [label="调料、香料、食用油、干货按每 10 g 比较\n其余食物按每 100 g 比较", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
  cards [label="食物列表\n先显示 60 张卡片，可点“显示更多”", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled"];
    { rank=same; confirmed; rest; }
    { rank=same; pinned; leading; }
    { rank=same; leading; tier; }

  confirmed -> pinned [color="#666666", label="确认后进入"];
  rest -> leading [color="#666666", label="pinTop 含这个营养素"];
  leading -> tier [color="#666666", label="其余食物"];
  tier -> rich [color="#666666", label="同一层里再比含量"];
  rich -> basis [color="#666666", label="比较份量看 amountBasisG"];
  pinned -> cards [color="#666666", label="最上面"];
  basis -> cards [color="#666666", label="排好序的卡片"];
  subgraph cluster_legend {
    label="图例";
    fontsize=11;
    style="rounded,dashed";
    color="#999999";
    node [fontname="Noto Sans CJK SC", margin="0.10,0.05"];
    legend_input [label="输入 / 输出：用户、浏览器、文件", fillcolor="#FFF4D6", color="#C9A227", fontcolor="#1B1B1B", shape=box, style="rounded,filled", fontsize=9];
    legend_code [label="本项目代码", fillcolor="#EAF2FB", color="#4A78A8", fontcolor="#1B1B1B", shape=box, style="rounded,filled", fontsize=9];
    { rank=same; legend_input; legend_code; }
  }
}
